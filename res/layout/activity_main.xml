<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛰️ Mock GPS Pro v1.3"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#00E676"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simulación Realista Anti-Heurística con Visor de Mapa"
            android:textSize="12sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="12dp" />

        <!-- Botones de Sistema -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_dev_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚙️ Desarrollador"
                android:textSize="11sp"
                android:background="#37474F"
                android:textColor="#80D8FF"
                android:padding="8dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_battery_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔋 Sin Batería Opt"
                android:textSize="11sp"
                android:background="#263238"
                android:textColor="#FFD54F"
                android:padding="8dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Coordenadas Base -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Latitud:"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_lat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="-36.82699"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:inputType="numberDecimal|numberSigned"
                    android:background="#242424"
                    android:padding="8dp"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Longitud:"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_lng"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="-73.04977"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:inputType="numberDecimal|numberSigned"
                    android:background="#242424"
                    android:padding="8dp"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Parámetros Anti-Detección -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Radio Deriva (m):"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_radius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="15.0"
                    android:textColor="#FFFFFF"
                    android:inputType="numberDecimal"
                    android:background="#242424"
                    android:padding="8dp"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calentamiento (s):"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_warmup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="15"
                    android:textColor="#FFFFFF"
                    android:inputType="number"
                    android:background="#242424"
                    android:padding="8dp"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botones de Acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ INICIAR"
                android:background="#00C853"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:padding="12dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏹ DETENER"
                android:background="#D50000"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:padding="12dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Presets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_preset_concepcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 Concepción"
                android:textSize="11sp"
                android:background="#2A2A2A"
                android:textColor="#FFFFFF"
                android:padding="6dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_preset_santiago"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 Santiago"
                android:textSize="11sp"
                android:background="#2A2A2A"
                android:textColor="#FFFFFF"
                android:padding="6dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Tarjeta de Estado -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado: En espera de inicio."
            android:textColor="#80D8FF"
            android:textSize="12sp"
            android:padding="10dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="12dp" />

        <!-- Sección de Mapa Interactivo en la Parte Inferior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗺️ Mapa en Vivo (Toca para fijar):"
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_center_map"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Centrar"
                android:textSize="10sp"
                android:background="#333333"
                android:textColor="#FFFFFF"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:minHeight="0dp"
                android:minWidth="0dp" />
        </LinearLayout>

        <WebView
            android:id="@+id/wv_map"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#222222" />

    </LinearLayout>
</ScrollView>
